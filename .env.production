# Production build settings for the admin panel. Public URLs, not secrets: Vite inlines
# every VITE_ variable into the bundle.
#
# The admin sends its session cookie with each request, which works because the API and
# the admin are subdomains of one registrable domain — SameSite=Lax allows that, and the
# API must list this exact origin in ADMIN_ORIGIN.
VITE_API_BASE=https://api.aarunyajewelsbyveena.in/api
VITE_STORE_URL=https://aarunyajewelsbyveena.in
